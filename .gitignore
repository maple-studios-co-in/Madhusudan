# SMC Agri (Madhusudhan) — Next.js site
# https://git-scm.com/docs/gitignore

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output
/.next/
/out/
/build
/dist
# verification builds (NEXT_DIST_DIR)
/.next-build

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# caches and generated types
.eslintcache
.stylelintcache
.cache/
.turbo/
*.tsbuildinfo
next-env.d.ts

# env files: never commit secrets; document keys in .env.example
.env
.env.*
!.env.example

# deployment
.vercel

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# certificates and keys
*.pem
*.key

# OS files (macOS, Windows / OneDrive)
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
~$*
*.tmp

# editors and local tooling
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/
